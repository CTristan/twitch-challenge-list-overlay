{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],

        // JavaScript Interoperability
        "allowJs": true, // include existing .js files in the program
        "checkJs": false, // don't strictly type-check JavaScript files
        "isolatedModules": true, // required for bundlers like Vite
        "noEmit": true, // Vite/esbuild handles emit

        // Type Checking - strict for TypeScript files only
        "strict": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "useUnknownInCatchVariables": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noPropertyAccessFromIndexSignature": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "verbatimModuleSyntax": true,

        // Path mapping for better imports
        "baseUrl": "./",
        "paths": {
            "@/*": ["src/*"],
            "@/types/*": ["types/*"]
        },

        "types": ["vite/client", "node", "vitest/globals"]
    },
    "include": [
        "src/**/*",
        "types/**/*",
        "tests/**/*",
        "vite.config.ts",
        "vitest.config.ts"
    ],
    "exclude": ["node_modules", "dist"]
}
